{
  "name": "iobroker.eebus",
  "version": "0.2.1",
  "description": "EEBUS SHIP/SPINE participant with LPC, LPP and MPC",
  "author": "TheBam <elektrobam@gmx.de>",
  "homepage": "https://github.com/TheBam1990/ioBroker.eebus",
  "license": "MIT",
  "main": "main.js",
  "files": [
    "admin",
    "io-package.json",
    "LICENSE",
    "main.js",
    "README.md",
    "README.de.md",
    "lib",
    "bin",
    "NOTICE",
    "scripts",
    "licenses",
    "bridge/*.go",
    "bridge/go.mod",
    "bridge/go.sum"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "keywords": [
    "ioBroker",
    "iobroker",
    "eebus",
    "ship",
    "spine",
    "smart-grid",
    "energy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBam1990/ioBroker.eebus.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.18.0"
  },
  "scripts": {
    "start": "node main.js",
    "test": "npm run test:unit && npm run test:package",
    "lint": "eslint .",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/integration.js --exit",
    "release": "release-script",
    "test:unit": "node --test test/helpers.test.js",
    "build:bridge": "node scripts/build-bridge.js",
    "build": "node scripts/build-bridge.js",
    "build:all": "node scripts/build-bridge.js --all"
  },
  "bugs": {
    "url": "https://github.com/TheBam1990/ioBroker.eebus/issues"
  },
  "readmeFilename": "README.md"
}
