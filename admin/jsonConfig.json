{
  "type": "tabs",
  "i18n": true,
  "items": {
    "pairing": {
      "type": "panel",
      "label": "Pairing / SKI",
      "items": {
        "_localSki": {
          "type": "state",
          "oid": "info.localSki",
          "label": "Local adapter SKI (copy into the tool)",
          "control": "input",
          "readOnly": true,
          "xs": 12
        },
        "_connection": {
          "type": "state",
          "oid": "info.connection",
          "label": "EEBUS connection",
          "control": "text",
          "readOnly": true,
          "xs": 12,
          "trueText": "Connected",
          "falseText": "Disconnected"
        },
        "_pairingWindow": {
          "type": "state",
          "oid": "pairing.windowOpen",
          "label": "Pairing window",
          "control": "text",
          "readOnly": true,
          "xs": 12,
          "trueText": "Open",
          "falseText": "Closed"
        },
        "_openPairing": {
          "type": "state",
          "oid": "control.openPairing",
          "label": "Open pairing window (120 seconds)",
          "control": "button",
          "readOnly": false,
          "xs": 12,
          "falseText": "Open pairing window (120 seconds)"
        },
        "_remoteSki": {
          "type": "state",
          "oid": "pairing.peerSki",
          "label": "Remote device SKI",
          "control": "input",
          "readOnly": false,
          "xs": 12
        },
        "_trustPeer": {
          "type": "state",
          "oid": "control.trustCurrentPeer",
          "label": "Trust selected device and connect",
          "control": "button",
          "readOnly": false,
          "xs": 12,
          "falseText": "Trust selected device and connect"
        },
        "_pairingInstructions": {
          "type": "staticText",
          "text": "Copy the local SKI into the Handwerkertool. Open pairing, select ioBroker in the tool, enter the tool SKI below and confirm trust on both sides. An existing pairing remains stored after disconnecting.",
          "xs": 12
        },
        "_discovered": {
          "type": "state",
          "oid": "discovery.peersJson",
          "label": "Discovered EEBUS devices",
          "control": "text",
          "readOnly": true,
          "xs": 12
        },
        "_pairingState": {
          "type": "state",
          "oid": "pairing.stateJson",
          "label": "Pairing status",
          "control": "text",
          "readOnly": true,
          "xs": 12
        },
        "_lastError": {
          "type": "state",
          "oid": "diagnostics.lastError",
          "label": "Last error",
          "control": "text",
          "readOnly": true,
          "xs": 12
        }
      }
    },
    "main": {
      "type": "panel",
      "label": "General",
      "items": {
        "enabled": {
          "type": "checkbox",
          "label": "Enable adapter",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "shipEnabled": {
          "type": "checkbox",
          "label": "Enable EEBUS SHIP and SPINE",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "deviceBrand": {
          "type": "text",
          "label": "Device brand",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "deviceModel": {
          "type": "text",
          "label": "Device model",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "deviceSerial": {
          "type": "text",
          "label": "Device serial",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        }
      }
    },
    "ship": {
      "type": "panel",
      "label": "SHIP",
      "items": {
        "shipBind": {
          "type": "text",
          "label": "Local bind address",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "shipPort": {
          "type": "number",
          "label": "Local SHIP port",
          "help": "EEbus SHIP commonly uses TCP/TLS port 4712.",
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6
        },
        "discoveryInterfaces": {
          "type": "text",
          "label": "Network interfaces (comma separated, empty = automatic)",
          "xs": 12,
          "help": "Use OS interface names such as eth0. Discovery and SHIP use the selected interfaces."
        }
      }
    },
    "certificate": {
      "type": "panel",
      "label": "Certificate",
      "items": {
        "autoGenerateCertificate": {
          "type": "checkbox",
          "label": "Generate local self-signed certificate if empty",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "certificatePem": {
          "type": "text",
          "label": "Certificate PEM",
          "minRows": 6,
          "maxRows": 12,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "certificateFile": {
          "type": "fileSelector",
          "label": "Certificate file (upload/download)",
          "help": "Upload a PEM/CRT/CER certificate. The uploaded file takes precedence over the manually entered PEM text.",
          "objectID": "eebus.%INSTANCE%.certificates",
          "pattern": "*.*",
          "upload": "/",
          "refresh": true,
          "noSize": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "privateKeyPem": {
          "type": "text",
          "label": "Private key PEM",
          "minRows": 6,
          "maxRows": 12,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "privateKeyFile": {
          "type": "fileSelector",
          "label": "Private key file (upload/download)",
          "help": "Upload or select the matching unencrypted PEM/KEY private key. Protect downloads of this sensitive file.",
          "objectID": "eebus.%INSTANCE%.certificates",
          "pattern": "*.*",
          "upload": "/",
          "refresh": true,
          "noSize": false,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
    "useCases": {
      "type": "panel",
      "label": "LPC / LPP / MPC",
      "items": {
        "simulation": {
          "type": "checkbox",
          "label": "Simulate power response to received limits (no physical device control)",
          "xs": 12
        },
        "initialPowerW": {
          "type": "number",
          "label": "Initial input power in W (+consumption, -production)",
          "xs": 12
        },
        "nominalConsumptionW": {
          "type": "number",
          "label": "Nominal maximum consumption in W",
          "min": 1,
          "xs": 6
        },
        "nominalProductionW": {
          "type": "number",
          "label": "Nominal maximum production in W",
          "min": 1,
          "xs": 6
        },
        "instructions": {
          "type": "staticText",
          "text": "Pair via Objects: open control.openPairing, enter the remote SKI into pairing.peerSki and press control.trustCurrentPeer. Local SKI: info.localSki. Discovered devices: discovery.peersJson. MPC input: measurements.inputPowerW. Received limits: lpc / lpp.",
          "newLine": true,
          "xs": 12
        }
      }
    }
  }
}
